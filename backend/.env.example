# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# --- Clerk (dashboard -> API keys; webhook signing secret from endpoint) -----
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Supabase (service role; server-only, bypasses RLS) ---------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# --- Embeddings (OpenAI-compatible) -----------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=64

# --- Completion (CLM / FIM) -------------------------------------------------
# provider: openai | anthropic | deepinfra
COMPLETION_PROVIDER=deepinfra
COMPLETION_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
COMPLETION_API_KEY=xxx
# COMPLETION_BASE_URL=https://api.deepinfra.com/v1/openai
COMPLETION_TEMPERATURE=0.1
COMPLETION_MAX_TOKENS=512

# --- RAG tuning -------------------------------------------------------------
RAG_MATCH_COUNT=12
RAG_LEXICAL_COUNT=20
RAG_TOKEN_BUDGET=4096
RAG_MIN_SIMILARITY=0.15
RRF_K=60
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
