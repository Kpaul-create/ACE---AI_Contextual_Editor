# ============================================================================
# ACE — production variable NAMES only. Values are NOT stored here; they are
# provisioned from a managed secret store (Doppler / Vault / Supabase Vault)
# and injected at runtime. This file documents the required contract.
# ============================================================================

NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=https://app.example.com

# Clerk live keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_<from-secret-manager>
CLERK_SECRET_KEY=sk_live_<from-secret-manager>
CLERK_WEBHOOK_SECRET=whsec_<from-secret-manager>

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<from-secret-manager>

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=<from-secret-manager>
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=64

# Completion
COMPLETION_PROVIDER=deepinfra
COMPLETION_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
COMPLETION_API_KEY=<from-secret-manager>
COMPLETION_TEMPERATURE=0.1
COMPLETION_MAX_TOKENS=512

RAG_MATCH_COUNT=12
RAG_LEXICAL_COUNT=20
RAG_TOKEN_BUDGET=4096
RAG_MIN_SIMILARITY=0.15
RRF_K=60
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

NEXT_PUBLIC_CLOUD_SYNC_ENDPOINT=https://api.example.com
