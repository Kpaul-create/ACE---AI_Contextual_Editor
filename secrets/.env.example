# ============================================================================
# ACE — local development template. COPY to a real .env.local (never commit).
# Run:  cp secrets/.env.example .env.local  &&  tsx secrets/validate-env.ts --file .env.local
# TIP: placeholder values fail validation on purpose — fill in real ones.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# --- Clerk (test-mode keys for local dev) -----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# --- Supabase (service-role; server-only, bypasses RLS) ---------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
# Optional: direct Postgres URI for migrations / psql.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ace

# --- Embeddings (OpenAI-compatible) -----------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=replace_me
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=64

# --- Completion (CLM / FIM) -------------------------------------------------
COMPLETION_PROVIDER=deepinfra
COMPLETION_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
COMPLETION_API_KEY=replace_me
# COMPLETION_BASE_URL=https://api.deepinfra.com/v1/openai
COMPLETION_TEMPERATURE=0.1
COMPLETION_MAX_TOKENS=512

# --- Browser service (Puppeteer) -------------------------------------------
BROWSER_USER_DATA_DIR=./data/browser
BROWSER_MAX_CONTEXTS=20

# --- OpenCode agent ---------------------------------------------------------
OPENCODE_BASE_URL=http://localhost:3001

# --- RAG tuning -------------------------------------------------------------
RAG_MATCH_COUNT=12
RAG_LEXICAL_COUNT=20
RAG_TOKEN_BUDGET=4096
RAG_MIN_SIMILARITY=0.15
RRF_K=60
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- Frontend (public; inlined into browser bundle) -------------------------
NEXT_PUBLIC_CLOUD_SYNC_ENDPOINT=http://localhost:8080
