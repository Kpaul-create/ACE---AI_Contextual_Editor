# ============================================================================
# ACE — test / CI template. REAL files are injected by the pipeline, never
# committed. Values here are deliberately fake but SHAPE-VALID so the gate
# passes without contacting live services.
# ============================================================================

NODE_ENV=test
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=error
CORS_ORIGINS=http://localhost:3000

# Fake Clerk (correct prefixes so pairing/format checks pass)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_fake
CLERK_SECRET_KEY=sk_test_fake
CLERK_WEBHOOK_SECRET=whsec_fake

# Fake Supabase
SUPABASE_URL=https://test.supabase.co
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key

# Fake embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=test-embedding-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=64

# Fake completion
COMPLETION_PROVIDER=deepinfra
COMPLETION_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
COMPLETION_API_KEY=test-completion-key
COMPLETION_TEMPERATURE=0.1
COMPLETION_MAX_TOKENS=512

RAG_MATCH_COUNT=12
RAG_LEXICAL_COUNT=20
RAG_TOKEN_BUDGET=4096
RAG_MIN_SIMILARITY=0.15
RRF_K=60
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

NEXT_PUBLIC_CLOUD_SYNC_ENDPOINT=http://localhost:8080
